{
  "schema": "experiments.spec.v1",
  "id": "minimal-latency",
  "description": "A minimal declarative experiment showing baseline/candidate measurements and separate promotion.",
  "scientific_method": {
    "question": { "text": "Does the candidate lower latency?" },
    "hypothesis": { "statement": "the candidate lowers latency", "rationale": null },
    "predictions": [],
    "independent_variables": [{ "name": "implementation", "description": null }],
    "dependent_variables": [{ "name": "latency", "unit": "ms", "description": null }],
    "controls": [],
    "criteria": [{
      "kind": "improvement",
      "baseline": { "condition": "baseline", "measurement": "latency" },
      "candidate": { "condition": "candidate", "measurement": "latency" },
      "direction": "lower_is_better",
      "minimum_fraction": 0.05
    }]
  },
  "target": { "root": ".", "label": "example" },
  "protocol": { "prepare": [], "baseline": [], "intervention": [], "candidate": [], "cleanup": [] },
  "verification": { "commands": [] },
  "measurements": {
    "measurements": [
      { "condition": "baseline", "name": "latency", "unit": "ms", "parser": "number", "command": { "label": "baseline latency", "program": "printf", "args": ["100"], "cwd": null } },
      { "condition": "candidate", "name": "latency", "unit": "ms", "parser": "number", "command": { "label": "candidate latency", "program": "printf", "args": ["90"], "cwd": null } }
    ]
  },
  "differences": [],
  "promotion": { "require_supported": true, "require_verification": true }
}
