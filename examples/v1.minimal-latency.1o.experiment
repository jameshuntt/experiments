experiment {
  schema "experiments.spec.v3"
  id "minimal-latency"
  description "A minimal declarative latency experiment."

  scientific_method {
    question {
      text "Does the candidate lower latency?"
    }
    hypothesis {
      statement "the candidate lowers latency"
    }
    independent_variable {
      name "implementation"
    }
    dependent_variable {
      name "latency"
      unit "ms"
    }
    criterion {
      kind "improvement"
      baseline {
        condition "baseline"
        measurement "latency"
      }
      candidate {
        condition "candidate"
        measurement "latency"
      }
      direction "lower_is_better"
      minimum_fraction 0.05
    }
  }

  target {
    root "."
    label "example"
  }

  mutation {
    mode "unbounded"
    backend "code_passenger"
  }

  measurements {
    measurement {
      phase "baseline"
      condition "baseline"
      name "latency"
      unit "ms"
      command {
        label "baseline latency"
        program "printf"
        arg "100"
      }
      parser "number"
    }
    measurement {
      phase "candidate"
      condition "candidate"
      name "latency"
      unit "ms"
      command {
        label "candidate latency"
        program "printf"
        arg "90"
      }
      parser "number"
    }
  }

  promotion {
    require_supported true
    require_verification true
  }
}
